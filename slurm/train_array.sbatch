#!/bin/bash
# One training run per array task, each with its own Showdown server.
# Submit from the repo root: sbatch --array=1-$(grep -c . slurm/sweep.txt) slurm/train_array.sbatch slurm/sweep.txt
# Generated by Claude Code.
#SBATCH --job-name=cs372-train
#SBATCH --partition=compsci
#SBATCH --cpus-per-task=2
#SBATCH --mem=4G
#SBATCH --time=08:00:00
#SBATCH --output=slurm/logs/%x_%A_%a.out

set -euo pipefail
SWEEP_FILE=$1
SHOWDOWN_DIR=${SHOWDOWN_DIR:-/usr/xtmp/$USER/pokemon-showdown}

# this task's line of the sweep file: <dqn|ppo> <training arguments>
read -r ALGO ARGS <<< "$(grep . "$SWEEP_FILE" | sed -n "${SLURM_ARRAY_TASK_ID}p")"

# private server copy on local disk: servers sharing one folder race on writing its data files
SERVER_COPY=$(mktemp -d /var/tmp/showdown.XXXXXX)
rsync -a --exclude node_modules --exclude .git "$SHOWDOWN_DIR/" "$SERVER_COPY/"
ln -s "$SHOWDOWN_DIR/node_modules" "$SERVER_COPY/node_modules"
# listen on localhost only: with --no-security, anyone on the node could otherwise connect
sed -i.bak "s/^exports.bindaddress = .*/exports.bindaddress = '127.0.0.1';/" "$SERVER_COPY/config/config.js"

# a port derived from the job id, so tasks sharing a node do not collide
export SHOWDOWN_PORT=$((20000 + SLURM_JOB_ID % 20000))
node "$SERVER_COPY/pokemon-showdown" start --no-security --skip-build "$SHOWDOWN_PORT" > /dev/null &
SERVER_PID=$!
trap 'kill $SERVER_PID; rm -rf "$SERVER_COPY"' EXIT

# wait until the server accepts connections
for _ in $(seq 60); do
    (echo > "/dev/tcp/localhost/$SHOWDOWN_PORT") 2> /dev/null && break
    sleep 1
done

echo "task $SLURM_ARRAY_TASK_ID on $(hostname), port $SHOWDOWN_PORT: $ALGO $ARGS"
source .venv/bin/activate
# battle-length warnings from Showdown are expected and flood the log
python -m "src.train_$ALGO" $ARGS 2>&1 | grep -v -E "bigerror|auto-tie"
